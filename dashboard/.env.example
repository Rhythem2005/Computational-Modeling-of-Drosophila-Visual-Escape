# Optional configuration. No real credentials belong in source files.
FLY_PROJECT_ROOT=/absolute/path/to/FLY
FLY_DASHBOARD_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000,http://localhost:8001,http://127.0.0.1:8001
# start.sh reuses/provisions .runtime/ingest-token privately. Viewers never need it.
# With direct uvicorn, unset disables ingestion; an explicitly empty value also disables it.
# FLY_DASHBOARD_INGEST_TOKEN=choose-a-local-secret-after-approval
# Optional additional committed episode directories under connectome/Results:
FLY_DASHBOARD_EXTRA_SOURCES=[]
